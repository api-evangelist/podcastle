                  "type": "text",
                  "description": "Voice description."
                },
                {
                  "key": "accent",
                  "value": "<string>",
                  "type": "text",
                  "description": "Accent specification."
                },
                {
                  "key": "gender",
                  "value": "<string>",
                  "type": "text",
                  "description": "Voice gender. (This can only be one of Male,Female,Neutral,Unspecified)"
                },
                {
                  "key": "style",
                  "value": "<string>",
                  "type": "text",
                  "description": "Voice style(s), comma-separated."
                },
                {
                  "key": "enhance",
                  "value": "false",
                  "type": "text",
                  "description": "Apply noise reduction to the sample."
                }
              ]
            }

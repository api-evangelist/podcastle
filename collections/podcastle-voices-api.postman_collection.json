          "id": "d1ee455d-765d-4e71-991f-adeca9a97c09",
          "name": "Create an instant voice clone.",
          "request": {
            "name": "Create an instant voice clone.",
            "description": {
              "content": "Creates a production-ready custom voice from a short audio clip. Accepts multipart/form-data with the audio sample and optional metadata. Supported audio formats: wav, mp3, flac, aiff.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "voices",
                "clone"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API version, for example v1.",
                "key": "version",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "description": "(Required) Audio clip file. Supported formats: wav, mp3, flac, aiff."
                },
                {
                  "key": "name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Voice name or label."
                },
                {
                  "key": "description",

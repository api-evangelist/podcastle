    "_postman_id": "964690b9-b6a3-438f-9a9b-697850de0813",
    "name": "Async (Podcastle) Voice Text to Speech API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Async Voice API is the developer platform behind Podcastle's AI audio engine. It exposes low-latency, human-like text-to-speech, a browsable voice library, and instant voice cloning. Podcastle.ai rebranded its developer platform as Async; the API is served from https://api.async.com and authenticated with an x-api-key header plus a version header. Only documented endpoints and fields are modeled here; no endpoints are fabricated.\n\nContact Support:\n Name: Async Support",
      "type": "text/plain"
    }
  }
